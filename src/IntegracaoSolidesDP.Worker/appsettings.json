{
  "ConnectionStrings": {
    "Rhu": ""
  },
  "SolidesDP": {
    "BaseUrl": "https://employer.tangerino.com.br",
    "Token": "",
    "TimeoutSeconds": 30,
    "SkipUnifiedSync": true,
    "AllowProductionApiOutsideProduction": false
  },
  "Execution": {
    "Interval": "00:30:00",
    "TimeZone": "America/Bahia",
    "RunOnStartup": true
  },
  "Sync": {
    "InstanceName": "default",
    "DryRun": true,
    "TiposColaborador": [ 1, 2 ],
    "EmpresasIncluidas": [],
    "ExternalIdAllowList": [],
    "SituacaoTransferido": "09",
    "SituacoesIgnoradas": [ "99" ],
    "GoLiveDate": null,
    "WorkScheduleExternalId": "",
    "PunchRuleExternalId": "",
    "CompanyMode": "ResolveByCnpj",
    "CreateMissingCompanies": false,
    "AllowDoubleBind": false,
    "MotivoDemissaoMap": {},
    "FeriasJanelaDias": 60,
    "FeriasEnviarProgramadas": false,
    "FeriasMotivoId": null,
    "FeriasEndDateMode": "InicioDoDiaSeguinte",
    "FeriasMaxTentativas": 5,
    "MaxCreatesPerRun": 300,
    "MaxCancellationsPerRun": 20,
    "ReportDirectory": "reports"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}" }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/integracao-solidesdp-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
