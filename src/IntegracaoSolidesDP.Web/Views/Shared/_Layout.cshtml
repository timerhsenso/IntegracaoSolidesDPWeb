@inject VersoesSistema Versoes
@inject AcessoErros AcessoErros
@{
    var controller = ViewContext.RouteData.Values["controller"] as string;
    var versaoServico = await Versoes.ServicoAsync(Context.RequestAborted);
    string Ativo(string alvo) => string.Equals(controller, alvo, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
    var nome = User.FindFirst(ClaimsWeb.Nome)?.Value ?? User.Identity?.Name;
    var perfil = Perfis.Todos.LastOrDefault(User.IsInRole) ?? "—";
    var ajudaDaTela = AjudaTopicos.DaTela(controller);
    var veErros = await AcessoErros.PodeVerAsync(User, Context.RequestAborted);
    var errosAbertos = veErros ? await AcessoErros.AbertosAsync(Context.RequestAborted) : 0;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Integração Sólides DP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/datatables-bs5/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @* Menu recolhido no computador: aplicado antes de desenhar a tela, para não piscar. *@
    <script>try { if (localStorage.getItem('menu-recolhido') === '1') document.body.classList.add('menu-recolhido'); } catch (e) { }</script>
    <aside class="app-sidebar">
        <a class="brand" asp-controller="Painel" asp-action="Index">
            <i class="bi bi-arrow-left-right"></i>
            <span>RHSenso <small>→ Sólides DP</small></span>
        </a>
        <nav class="nav flex-column">
            <a class="nav-link @Ativo("Painel")" asp-controller="Painel" asp-action="Index"><i class="bi bi-speedometer2"></i> Painel</a>
            <a class="nav-link @Ativo("Empresas")" asp-controller="Empresas" asp-action="Index"><i class="bi bi-building"></i> Empresas</a>
            <a class="nav-link @Ativo("Execucoes")" asp-controller="Execucoes" asp-action="Index"><i class="bi bi-clock-history"></i> Execuções</a>
            <a class="nav-link @Ativo("Migrados")" asp-controller="Migrados" asp-action="Index"><i class="bi bi-people"></i> O que foi migrado</a>
            <a class="nav-link @Ativo("Conferencia")" asp-controller="Conferencia" asp-action="Index"><i class="bi bi-ui-checks"></i> Conferência DP x RHSenso</a>
            <a class="nav-link @Ativo("Pendencias")" asp-controller="Pendencias" asp-action="Index"><i class="bi bi-exclamation-triangle"></i> Pendências</a>
            <a class="nav-link @Ativo("Comandos")" asp-controller="Comandos" asp-action="Index"><i class="bi bi-terminal"></i> Pedidos ao serviço</a>
            <a class="nav-link @Ativo("Configuracao")" asp-controller="Configuracao" asp-action="Index"><i class="bi bi-sliders"></i> Regras gerais</a>
            @if (User.IsInRole(Perfis.Admin))
            {
                <div class="nav-titulo">Administração</div>
                <a class="nav-link @Ativo("Usuarios")" asp-controller="Usuarios" asp-action="Index"><i class="bi bi-person-gear"></i> Usuários</a>
                <a class="nav-link @Ativo("Notificacoes")" asp-controller="Notificacoes" asp-action="Index"><i class="bi bi-envelope"></i> Notificações</a>
                <a class="nav-link @Ativo("Auditoria")" asp-controller="Auditoria" asp-action="Index"><i class="bi bi-journal-text"></i> Auditoria</a>
            }
            <div class="nav-titulo">Suporte</div>
            @if (veErros)
            {
                <a class="nav-link @Ativo("Erros")" asp-controller="Erros" asp-action="Index" asp-route-situacao="@(errosAbertos > 0 ? "aberto" : null)">
                    <i class="bi bi-bug"></i> Erros da aplicação
                    @if (errosAbertos > 0)
                    {
                        <span class="badge rounded-pill text-bg-danger ms-1" title="Erros abertos">@(errosAbertos > 99 ? "99+" : errosAbertos.ToString(System.Globalization.CultureInfo.InvariantCulture))</span>
                    }
                </a>
            }
            <a class="nav-link @Ativo("Ajuda")" asp-controller="Ajuda" asp-action="Index"><i class="bi bi-question-circle"></i> Ajuda</a>
        </nav>
        <div class="app-versao" title="Versões instaladas. Web e serviço devem ser do mesmo pacote. Clique para ver as novidades.">
            <a asp-controller="Ajuda" asp-action="Novidades" class="text-reset text-decoration-none">Web @Versoes.Web · Serviço @(versaoServico ?? "—")</a>
            @if (versaoServico is not null && versaoServico != Versoes.Web)
            {
                <i class="bi bi-exclamation-triangle-fill text-warning" title="Web e serviço em versões diferentes: atualize os dois com o mesmo pacote."></i>
            }
        </div>
    </aside>

    <div class="app-main">
        <header class="app-topbar d-flex align-items-center px-3 py-2 gap-3">
            <button type="button" class="btn btn-sm btn-outline-secondary" data-alternar-menu aria-label="Mostrar ou ocultar o menu" title="Mostrar ou ocultar o menu"><i class="bi bi-list"></i></button>
            <h1 class="h5 mb-0 flex-grow-1">@ViewData["Title"]</h1>
            @if (ajudaDaTela is not null)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="offcanvas" data-bs-target="#ajuda-tela"
                        aria-controls="ajuda-tela" title="Ajuda desta tela">
                    <i class="bi bi-question-circle"></i><span class="d-none d-md-inline"> Ajuda</span>
                </button>
            }
            <div class="dropdown">
                <button class="btn btn-sm btn-light dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-person-circle"></i> @nome <span class="badge text-bg-secondary ms-1">@perfil</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" asp-controller="Conta" asp-action="AlterarSenha"><i class="bi bi-key"></i> Alterar senha</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <form asp-controller="Conta" asp-action="Sair" method="post">
                            <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right"></i> Sair</button>
                        </form>
                    </li>
                </ul>
            </div>
        </header>

        <main class="p-3 p-lg-4">
            <partial name="_Mensagens" />
            @RenderBody()
        </main>
    </div>

    @if (ajudaDaTela is not null)
    {
        @* Ajuda contextual: o mesmo texto da página Ajuda, só o tópico desta tela. *@
        <div class="offcanvas offcanvas-end ajuda-offcanvas" tabindex="-1" id="ajuda-tela" aria-labelledby="ajuda-tela-titulo">
            <div class="offcanvas-header border-bottom">
                <h2 class="offcanvas-title h5" id="ajuda-tela-titulo"><i class="bi @ajudaDaTela.Icone"></i> @ajudaDaTela.Titulo</h2>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fechar"></button>
            </div>
            <div class="offcanvas-body ajuda-texto">
                <partial name="@ajudaDaTela.Partial" />
                <hr />
                <a class="btn btn-sm btn-outline-primary" asp-controller="Ajuda" asp-action="Index" asp-fragment="@ajudaDaTela.Id">
                    <i class="bi bi-book"></i> Abrir o manual completo
                </a>
            </div>
        </div>
    }

    @* Caixa de diálogo padrão do sistema (confirmação, motivo, erro). Preenchida por app.dialogo em site.js. *@
    <div class="modal fade" id="app-dialogo" tabindex="-1" aria-labelledby="app-dialogo-titulo" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content app-dialogo">
                <div class="modal-header">
                    <h2 class="modal-title h5 d-flex align-items-center gap-2" id="app-dialogo-titulo">
                        <i class="bi" data-dialogo-icone></i><span data-dialogo-titulo></span>
                    </h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0 app-dialogo-mensagem" data-dialogo-mensagem></p>
                    <div class="mt-3 d-none" data-dialogo-campo>
                        <label class="form-label small fw-semibold" for="app-dialogo-texto" data-dialogo-rotulo>Motivo</label>
                        <textarea id="app-dialogo-texto" class="form-control" rows="3" maxlength="500"></textarea>
                        <div class="invalid-feedback">Informe o motivo para continuar.</div>
                        <div class="form-text">Fica registrado na auditoria.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" data-dialogo-cancelar>Cancelar</button>
                    <button type="button" class="btn btn-primary" data-dialogo-ok>Confirmar</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/datatables/js/dataTables.min.js"></script>
    <script src="~/lib/datatables-bs5/js/dataTables.bootstrap5.min.js"></script>
    <script>window.rotulos = @Json.Serialize(Rotulos.ParaJavaScript); window.appBase = @Json.Serialize(Url.Content("~/"));</script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
