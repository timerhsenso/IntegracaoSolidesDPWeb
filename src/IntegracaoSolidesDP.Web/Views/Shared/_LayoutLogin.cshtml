<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Integração Sólides DP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="tela-login">
    <main class="card shadow-sm login-card">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <i class="bi bi-arrow-left-right fs-1 text-primary"></i>
                <h1 class="h5 mt-2 mb-0">Integração RHSenso → Sólides DP</h1>
                <p class="text-body-secondary small mb-0">@ViewData["Title"]</p>
            </div>
            @RenderBody()
        </div>
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
