@model ErroViewModel
@{
    ViewData["Title"] = "Erro";
    Layout = "_LayoutLogin";
}
@if (Model.Enviado is { } enviado)
{
    <div class="alert alert-success small">
        <i class="bi bi-check2-circle"></i> @enviado
        @if (Model.Codigo is { } codigoEnviado)
        {
            <div class="mt-1">Código do erro: <strong class="font-monospace">@codigoEnviado</strong></div>
        }
    </div>
}
else
{
    <div class="alert alert-danger small">
        <i class="bi bi-bug"></i> Ocorreu um erro inesperado.
        @if (Model.Codigo is { } codigo)
        {
            <div class="mt-2">
                Código do erro: <strong class="font-monospace fs-6" id="codigo-erro">@codigo</strong>
            </div>
            <div class="mt-1">
                @if (Model.AvisoAutomatico)
                {
                    <span>O suporte já foi avisado. Tente de novo em alguns instantes.</span>
                }
                else if (Model.PodeEnviar)
                {
                    <span>Use o botão abaixo para avisar o suporte, ou informe este código ao administrador.</span>
                }
                else
                {
                    <span>Informe este código ao administrador do sistema. Tente de novo em alguns instantes.</span>
                }
            </div>
        }
        else
        {
            <span>O detalhe ficou registrado no log da aplicação; tente de novo ou avise o administrador.</span>
        }
    </div>
    @if (Model.PodeEnviar && Model.Id is { } id)
    {
        <form asp-controller="Erro" asp-action="Enviar" method="post" class="mb-3">
            <input type="hidden" name="id" value="@id" />
            <label for="comentario" class="form-label small">O que você estava fazendo?</label>
            <textarea id="comentario" name="comentario" class="form-control mb-2" rows="3" maxlength="1000"
                      placeholder="Ex.: salvando as filiais da empresa 15"></textarea>
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-send"></i> @(Model.AvisoAutomatico ? "Enviar comentário ao suporte" : "Enviar ao suporte")
            </button>
        </form>
    }
}
<a class="btn btn-outline-secondary w-100" href="~/">Voltar ao início</a>
