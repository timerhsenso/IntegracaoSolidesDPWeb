<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuração do IIS para a Web de gestão. O dotnet publish completa processPath/arguments
  (o executável self-contained IntegracaoSolidesDP.Web.exe). Não guarde segredos aqui: connection
  string e chave dos tokens ficam no appsettings.json da pasta do site (protegido por permissão de
  pasta pelo install-web.ps1) ou em variáveis de ambiente.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- In-process: roda dentro do w3wp do app pool. stdout só para diagnosticar falha na partida (500.30). -->
      <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" hostingModel="inprocess"
                  stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering removeServerHeader="true">
          <!-- appsettings*.json e logs nunca são servidos (o ASP.NET Core já não serve, isto é a segunda barreira). -->
          <hiddenSegments>
            <add segment="logs" />
          </hiddenSegments>
          <fileExtensions>
            <add fileExtension=".json" allowed="false" />
          </fileExtensions>
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
