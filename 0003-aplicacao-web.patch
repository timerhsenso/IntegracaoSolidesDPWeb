+@model ConfiguracaoViewModel
+@using IntegracaoSolidesDP.Worker.Options
+@{
+    ViewData["Title"] = "Configuração";
+    var somenteLeitura = !Model.PodeEditar;
+}
+<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
+    <div class="flex-grow-1 small">
+        @if (Model.Atual is { } atual)
+        {
+            <span>Em vigor: <strong>versão @atual.Version</strong> (@(atual.Active ? "ativa" : "desativada")), por @atual.CreatedBy em @F.Data(atual.CreatedAt).</span>
+            @if (!string.IsNullOrWhiteSpace(atual.Note))
+            {
+                <span class="text-body-secondary">Motivo: @atual.Note</span>
+            }
+        }
+        else
+        {
+            <span>Ainda não há configuração no banco: o serviço usa o appsettings.json e cria a versão 1 na próxima execução. Salvar aqui cria a versão 1.</span>
+        }
+    </div>
+    <a class="btn btn-sm btn-outline-secondary" asp-action="Historico"><i class="bi bi-clock-history"></i> Histórico de versões</a>
+</div>
+
+@if (somenteLeitura)
+{
+    <div class="alert alert-light border small"><i class="bi bi-eye"></i> Somente o perfil Admin altera a configuração.</div>
+}
+
+<form asp-action="Salvar" method="post" novalidate>
+    <div asp-validation-summary="All" class="alert alert-danger small"></div>
+    <fieldset disabled="@somenteLeitura">
+        <div class="row g-3">
+            <div class="col-xl-6">
+                <div class="card h-100">
+                    <div class="card-header">Envio</div>
+                    <div class="card-body">
+                        <div class="form-check form-switch mb-3">
+                            <input asp-for="Form.DryRun" class="form-check-input" role="switch" />
+                            <label asp-for="Form.DryRun" class="form-check-label"></label>
+                        </div>
+                        <div class="mb-3">
+                            <label asp-for="Form.GoLiveDate" class="form-label"></label>
+                            <input type="date" name="Form.GoLiveDate" id="Form_GoLiveDate" class="form-control w-auto"
+                                   value="@Model.Form.GoLiveDate?.ToString("yyyy-MM-dd")" />
+                            <div class="form-text">Obrigatória para o envio real. Quem foi admitido antes começa no DP nesta data.</div>
+                        </div>
+                        <div class="row g-2">
+                            <div class="col-md-6">
+                                <label asp-for="Form.MaxCreatesPerRun" class="form-label"></label>
+                                <input asp-for="Form.MaxCreatesPerRun" class="form-control" />
+                            </div>
+                            <div class="col-md-6">
+                                <label asp-for="Form.MaxCancellationsPerRun" class="form-label"></label>
+                                <input asp-for="Form.MaxCancellationsPerRun" class="form-control" />
+                            </div>
+                        </div>
+                    </div>
+                </div>
+            </div>
+
+            <div class="col-xl-6">
+                <div class="card h-100">
+                    <div class="card-header">Quem entra</div>
+                    <div class="card-body">
+                        <div class="row g-2">
+                            <div class="col-md-6 mb-2">
+                                <label asp-for="Form.TiposColaborador" class="form-label"></label>
+                                <input asp-for="Form.TiposColaborador" class="form-control" placeholder="1, 2" />
+                                <span asp-validation-for="Form.TiposColaborador" class="text-danger small"></span>
+                            </div>
+                            <div class="col-md-6 mb-2">
+                                <label asp-for="Form.EmpresasIncluidas" class="form-label"></label>
+                                <input asp-for="Form.EmpresasIncluidas" class="form-control" placeholder="7, 14" />
+                                <span asp-validation-for="Form.EmpresasIncluidas" class="text-danger small"></span>
+                            </div>
+                            <div class="col-md-6 mb-2">
+                                <label asp-for="Form.SituacaoTransferido" class="form-label"></label>
+                                <input asp-for="Form.SituacaoTransferido" class="form-control" />
+                            </div>
+                            <div class="col-md-6 mb-2">
+                                <label asp-for="Form.SituacoesIgnoradas" class="form-label"></label>
+                                <input asp-for="Form.SituacoesIgnoradas" class="form-control" />
+                            </div>
+                        </div>
+                        <label asp-for="Form.ExternalIdAllowList" class="form-label"></label>
+                        <textarea asp-for="Form.ExternalIdAllowList" class="form-control font-monospace" rows="3"></textarea>
+                        <div class="form-check mt-3">
+                            <input asp-for="Form.AllowDoubleBind" class="form-check-input" />
+                            <label asp-for="Form.AllowDoubleBind" class="form-check-label"></label>
+                        </div>
+                    </div>
+                </div>
+            </div>
+
+            <div class="col-xl-6">
+                <div class="card h-100">
+                    <div class="card-header">Sólides DP</div>
+                    <div class="card-body">
+                        <div class="mb-2">
+                            <label asp-for="Form.CompanyMode" class="form-label"></label>
+                            <select asp-for="Form.CompanyMode" class="form-select">
+                                <option value="@CompanyMode.ResolveByCnpj">Procurar a empresa pelo CNPJ da filial</option>
+                                <option value="@CompanyMode.None">Não enviar empresa (conta com uma só empresa)</option>
+                            </select>
+                        </div>
+                        <div class="form-check mb-3">
+                            <input asp-for="Form.CreateMissingCompanies" class="form-check-input" />
+                            <label asp-for="Form.CreateMissingCompanies" class="form-check-label"></label>
+                        </div>
+                        <div class="mb-2">
+                            <label asp-for="Form.WorkScheduleExternalId" class="form-label"></label>
+                            <input asp-for="Form.WorkScheduleExternalId" class="form-control" />
+                        </div>
+                        <div class="mb-2">
+                            <label asp-for="Form.PunchRuleExternalId" class="form-label"></label>
+                            <input asp-for="Form.PunchRuleExternalId" class="form-control" />
+                        </div>
+                        <div class="form-text">Os ids aparecem em Pedidos ao serviço › Consultar o Sólides DP.</div>
+                    </div>
+                </div>
+            </div>
+
+            <div class="col-xl-6">
+                <div class="card h-100">
+                    <div class="card-header">Férias e desligamentos</div>
+                    <div class="card-body">
+                        <div class="row g-2">
+                            <div class="col-md-6 mb-2">
+                                <label asp-for="Form.FeriasJanelaDias" class="form-label"></label>
+                                <input asp-for="Form.FeriasJanelaDias" class="form-control" />
+                                <span asp-validation-for="Form.FeriasJanelaDias" class="text-danger small"></span>
+                            </div>
+                            <div class="col-md-6 mb-2">
+                                <label asp-for="Form.FeriasMaxTentativas" class="form-label"></label>
+                                <input asp-for="Form.FeriasMaxTentativas" class="form-control" />
+                                <span asp-validation-for="Form.FeriasMaxTentativas" class="text-danger small"></span>
+                            </div>
+                            <div class="col-md-6 mb-2">
+                                <label asp-for="Form.FeriasMotivoId" class="form-label"></label>
+                                <input asp-for="Form.FeriasMotivoId" class="form-control" />
+                            </div>
+                            <div class="col-md-6 mb-2">
+                                <label asp-for="Form.FeriasEndDateMode" class="form-label"></label>
+                                <select asp-for="Form.FeriasEndDateMode" class="form-select">
+                                    <option value="@FeriasEndDateMode.InicioDoDiaSeguinte">00:00 do dia seguinte ao último dia</option>
+                                    <option value="@FeriasEndDateMode.InicioDoUltimoDia">00:00 do último dia</option>
+                                    <option value="@FeriasEndDateMode.FimDoUltimoDia">23:59:59 do último dia</option>
+                                </select>
+                            </div>
+                        </div>
+                        <div class="form-check mb-3">
+                            <input asp-for="Form.FeriasEnviarProgramadas" class="form-check-input" />
+                            <label asp-for="Form.FeriasEnviarProgramadas" class="form-check-label"></label>
+                        </div>
+                        <label asp-for="Form.MotivoDemissaoMap" class="form-label"></label>
+                        <textarea asp-for="Form.MotivoDemissaoMap" class="form-control font-monospace" rows="3" placeholder="21=PEDIDO_DEMISSAO_COLABORADOR"></textarea>
+                        <span asp-validation-for="Form.MotivoDemissaoMap" class="text-danger small"></span>
+                    </div>
+                </div>
+            </div>
+        </div>
+
+        @if (Model.PodeEditar)
+        {
+            <div class="card mt-3">
+                <div class="card-body">
+                    <label asp-for="Form.Observacao" class="form-label"></label>
+                    <input asp-for="Form.Observacao" class="form-control" maxlength="500" />
+                    <span asp-validation-for="Form.Observacao" class="text-danger small"></span>
+                    <div class="d-flex align-items-center gap-3 mt-3">
