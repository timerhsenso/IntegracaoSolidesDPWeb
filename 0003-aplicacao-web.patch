+/// a conversão para <see cref="SyncOptions"/> devolve os erros de digitação, e as regras de
+/// negócio são as do <see cref="SyncOptionsValidator"/> (as mesmas do serviço).
+/// </summary>
+public sealed class ConfiguracaoForm
+{
