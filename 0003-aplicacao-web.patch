+@{
+    ViewData["Title"] = "Execuções";
+}
+<div class="card">
+    <div class="card-body">
+        <table id="execucoes" class="table table-sm table-hover w-100">
+            <thead>
+                <tr><th>Início</th><th>Modo</th><th>Origem</th><th>Pedida por</th><th>Status</th><th>Duração</th><th>Config.</th><th>Resumo</th></tr>
+            </thead>
+        </table>
